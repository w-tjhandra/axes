# Salin menjadi .env lalu sesuaikan. Jangan commit .env.
# Jalankan dengan ./run.sh — run.sh memuat berkas ini otomatis.

# --- Inti ---------------------------------------------------------------
# Path database SQLite. Default: app/data/ukk.db
# DB_PATH=./data/ukk.db

# Alamat bind dan port. run.sh memakai 0.0.0.0:${PORT:-8000}.
# HOST=0.0.0.0
# PORT=8000

# --- Sesi & cookie ------------------------------------------------------
# SESSION_COOKIE_NAME=ukk_session
# SESSION_DAYS=7
# Wajib 1 bila aplikasi diakses lewat HTTPS (produksi).
# COOKIE_SECURE=1
# Set 1 hanya jika berada di belakang reverse proxy tepercaya (Caddy/Nginx).
# TRUST_PROXY=1
# HSTS=1

# --- Backup -------------------------------------------------------------
# Default: ./backups relatif terhadap direktori app.
# BACKUP_DIR=./backups
# Opsional: enkripsi AES-256-CBC; butuh openssl di server.
# BACKUP_KEY=ganti-dengan-kunci-panjang

# --- Sinkronisasi Google Sheets (opsional, disabled-safe) ---------------
# GOOGLE_SHEETS_ID=1AbCdEf...
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/ke/service-account.json

# --- API key untuk klien sync skor (opsional) ---------------------------
# SYNC_API_KEY=ganti-dengan-token-acak
