# Virtual Environment & Python Cache
.venv/
app/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
app/.pytest_cache/

# Environment Variables & Secrets (Zero Secret Leakage)
.env
app/.env
*service-account*.json
*credentials*.json

