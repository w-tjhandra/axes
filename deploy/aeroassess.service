[Unit]
Description=AeroAssess Assessor & Competency Portal
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/aeroassess/app
EnvironmentFile=/opt/aeroassess/app/.env
ExecStart=/opt/aeroassess/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
KillMode=process
PrivateTmp=true

[Install]
WantedBy=multi-user.target
